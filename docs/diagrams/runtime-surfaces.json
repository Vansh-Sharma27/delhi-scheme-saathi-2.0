    {"dot": "cyan", "title": "Existing lifecycle behavior", "items": ["FastAPI lifespan is shared by container and Mangum today; final lifecycle separation is still Phase 6 work.", "Pool initialization errors are caught; the API can start with a disconnected database.", "Shutdown stops the local worker, closes the queue and closes the pool."]},
    {"dot": "amber", "title": "Worker ownership", "items": ["An in-memory queue starts a task in the API process; SQS expects the separately configured worker Lambda.", "The worker configures DynamoDB once per runtime and processes SQS records sequentially.", "SAM configures batch size 5 and ReportBatchItemFailures; DLQ redrive follows five receives."]},
    {"dot": "rose", "title": "Configuration and script limits", "items": ["Session selection still depends on USE_BEDROCK or a non-default table name.", "fork_session imports current src.main wiring and refuses a process-local in-memory store.", "The SAM template supplies DatabaseUrl but does not create PostgreSQL/RDS.", "DynamoDB, SQS and PostgreSQL are separate resources, not an isolated single-runtime deployment."]}
