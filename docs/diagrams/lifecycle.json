  "cards": [
    {"dot": "cyan", "title": "Time semantics", "items": ["Clock identity survives copies and resets; clock state is never serialized.", "copy_with owns the default updated_at stamp.", "DynamoDB saves preserve updated_at; in-memory saves refresh it."]},
    {"dot": "amber", "title": "Refresh is conditional", "items": ["Defaults: eight completed turns or approximately 6000 context tokens.", "A pending job suppresses another refresh request; an unavailable queue clears the marker and saves again.", "The worker skips missing sessions, other work types and sessions without a pending flag.", "Refresh exceptions clear the marker; decode or save failures can still produce SQS batch failures.", "Foreground and background saves can still overwrite each other."]},
    {"dot": "rose", "title": "Expiry is not an exact deadline", "items": ["TTL equals updated_at plus seven days; reads do not reject TTL-eligible rows.", "The in-memory backend has no TTL cleanup.", "An expired row that DynamoDB has not removed can still be read."]}
